{
  "name": "workday-mcp",
  "version": "1.1.3",
  "mcpName": "io.github.chrischall/workday-mcp",
  "description": "Workday MCP server for Claude — developed and maintained by AI (Claude Code)",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/workday-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "workday",
    "hr",
    "payroll",
    "benefits"
  ],
  "type": "module",
  "bin": {
    "workday-mcp": "dist/bundle.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "server.json",
    "skills",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "dev": "node dist/bundle.js",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^2.4.0",
    "@fetchproxy/server": "^3.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
